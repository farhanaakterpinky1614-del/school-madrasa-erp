APP_NAME="School & Madrasa ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Dhaka

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# Production / shared hosting: MySQL 8+ (default connection name: mysql)
# Local / CI smoke: SQLite is supported — uncomment the sqlite block below
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_madrasa_erp
DB_USERNAME=root
DB_PASSWORD=

# Local / CI alternative (SQLite):
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite
# (Leave DB_HOST/PORT/USERNAME/PASSWORD unset when using sqlite)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Phase 03 security policy (see config/identity.php)
SME_PASSWORD_MIN=8
SME_PASSWORD_MIXED=false
SME_PASSWORD_NUMBER=true
SME_PASSWORD_SYMBOL=false
SME_RATE_LOGIN=5
SME_RATE_RESET=3

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Tenancy (Phase 02)
# ---------------------------------------------------------------------------
TENANCY_BASE_DOMAIN=localhost
TENANCY_CENTRAL_DOMAINS=localhost,127.0.0.1
TENANCY_PLATFORM_HOSTS=admin.localhost
# Local/demo: bind tenant from authenticated user on central hosts.
# Production should set false and rely on subdomain / custom domain resolution.
TENANCY_USER_FALLBACK=true

